# База данных
APP_REPOSITORY_POSTGRES_HOST=postgres_order-service
APP_REPOSITORY_POSTGRES_PORT=5432
APP_REPOSITORY_POSTGRES_DB=testdb
APP_REPOSITORY_POSTGRES_USERNAME=testuser
APP_REPOSITORY_POSTGRES_PASSWORD=testpass

# HTTP сервер
APP_PROCESSOR_HTTP_PORT=9020

# Мониторинг
APP_MONITOR_LOG_LEVEL=info
APP_MONITOR_PROMETHEUS_ENABLED=true

CATALOG_SERVICE_GRPC_ADDR=catalog-service:50051


